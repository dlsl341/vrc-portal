rules_version = '2';

// VRC Rowing Portal – photo storage rules
// Photos (damage reports, profile pictures) live under photos/. The portal shows them through
// download links that carry an unguessable token, so these rules only govern direct access.
service firebase.storage {
  match /b/{bucket}/o {
    match /photos/{file} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && request.resource.size < 8 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
