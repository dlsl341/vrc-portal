rules_version = '2';

// VRC Rowing Portal – Firestore security rules
//
// Who's who
//   signed in : anyone who has logged in (Google or email link). Can only see the member
//               directory, manage their own profile request, and their own public profile name.
//   member    : a signed-in person whose account an admin has linked to a member record
//               (accounts/{uid} exists). Can book, report damage, log maintenance, edit own details.
//   admin     : the owner (config/settings.ownerUid) or anyone listed in admins/{uid}.
//               Can change boats, members, programs, sessions and see private details.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function settingsPath() { return /databases/$(database)/documents/config/settings; }
    function isOwner() {
      return signedIn() && exists(settingsPath()) && get(settingsPath()).data.ownerUid == uid();
    }
    function isAdmin() {
      return signedIn() && (isOwner() || exists(/databases/$(database)/documents/admins/$(uid())));
    }
    function isMember() {
      return signedIn() && exists(/databases/$(database)/documents/accounts/$(uid()));
    }
    function canUse() { return isMember() || isAdmin(); }
    function myMemberId() {
      return get(/databases/$(database)/documents/accounts/$(uid())).data.memberId;
    }
    function isCoach() {                  // a linked member with the Coach role
      return isMember() && 'coach' in get(/databases/$(database)/documents/members/$(myMemberId())).data.get('roles', []);
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---- setup: the first person to sign in after deployment claims ownership ----
    match /config/settings {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(settingsPath())
                    && request.resource.data.ownerUid == uid();
      allow update: if isOwner() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;
    }

    // ---- people & access ----
    match /profiles/{userId} {            // display name for each signed-in account
      allow read: if signedIn();
      allow write: if signedIn() && userId == uid();
    }
    match /accounts/{userId} {            // account -> member link, written by admins on approval
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow write: if isAdmin();
    }
    match /admins/{userId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /claims/{userId} {              // "this is me" profile requests
      allow read: if signedIn() && (userId == uid() || isAdmin());
      allow create, update: if signedIn() && ((userId == uid() && request.resource.data.status == 'pending') || isAdmin());
      allow delete: if signedIn() && (userId == uid() || isAdmin());
    }
    match /members/{memberId} {           // names + programs: readable so new people can find themselves
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /memberPrefs/{key} {            // sides, experience, bio, photo – keyed by account id once linked
      allow read: if canUse();
      allow write: if isAdmin() || (isMember() && key == uid());
    }
    match /memberPrivate/{key} {          // email, phone, emergency contact, weight
      allow read, write: if isAdmin() || (isMember() && key == uid());
    }

    // ---- club data that only admins change ----
    match /boats/{id}       { allow read: if canUse(); allow write: if isAdmin(); }
    match /programs/{id}    { allow read: if canUse(); allow write: if isAdmin(); }
    match /sessions/{id}    { allow read: if canUse(); allow write: if isAdmin(); }
    match /occurrences/{id} {
      allow read: if canUse();
      allow write: if isAdmin();
      // coaches may cancel or reinstate a date (only the cancellation fields)
      function cancelKeys() { return ['sessionId', 'date', 'cancelled', 'reasonCode', 'reason', 'cancelNotes', 'cancelledBy',
                                      'cancelledAt', 'notify', 'notified', 'notifyReinstate', 'reinstateNotes', 'reinstatedAt', 'updatedAt']; }
      allow create: if isCoach() && request.resource.data.keys().hasOnly(cancelKeys());
      allow update: if isCoach() && onlyChanges(cancelKeys());
    }
    match /activity/{id}    { allow read: if canUse(); allow write: if isAdmin(); }
    match /crews/{id}       { allow read: if canUse(); allow write: if isAdmin(); }

    // ---- things members add ----
    match /issues/{id} {
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid()
                                      && request.resource.data.status == 'open');
      // the reporter can add photos to their own open report; admins can do anything
      allow update: if isAdmin() || (isMember() && resource.data.by == uid()
                                      && onlyChanges(['photos', 'updatedAt']));
      allow delete: if isAdmin();
    }
    match /maintenance/{id} {
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid());
      allow update, delete: if isAdmin();
    }
    // ---- coxswain availability: each member edits their own; admins can edit anyone's ----
    match /coxAvail/{mid} {
      allow read: if canUse();
      allow write: if isAdmin() || (isMember() && mid == myMemberId());
    }

    // ---- no-show / late-cancel fees. Admins set a rule per program (feeRules/{programId}); the server
    // (functions) creates fees/{id}, sends the emails and the weekly report. Admins may only waive / re-apply.
    match /feeRules/{pid} {
      allow read: if canUse();
      allow write: if isAdmin();
    }
    match /fees/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.memberId == myMemberId());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'waivedBy', 'waivedAt', 'waiveNote', 'updatedAt'])
        && request.resource.data.status in ['charged', 'waived'];
      allow create, delete: if false;
    }
    match /feeRuns/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }
    match /feeReports/{id} {                 // "Email me this week's report" – the server answers
      allow read: if isAdmin();
      allow create, update: if isAdmin() && id == 'request';
    }

    // ---- invitations: admins email a one-time sign-in link for a member profile (the server sends and redeems it)
    match /invites/{token} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.status == 'pending' && token.size() >= 24;
      allow update, delete: if isAdmin();
    }

    // ---- regattas (admins only); boatHolds = the public part that takes boats out of booking
    match /regattas/{id} {
      allow read, write: if isAdmin();
    }
    match /boatHolds/{id} {
      allow read: if canUse();
      allow write: if isAdmin();
    }

    // ---- developer feedback (bugs / ideas / feedback). Everyone using the portal reads and +1s; authors edit or delete
    // their own while it's still "new"; admins set status/notes. appSettings/features: admins switch the tab off/on.
    match /feedback/{id} {
      function votesOf(d) { return d.get('votes', {}); }
      function onlyMyVote() { return votesOf(request.resource.data).diff(votesOf(resource.data)).affectedKeys().hasOnly([uid()]); }
      function fbFields() { return request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 140
                                   && request.resource.data.get('details', '').size() <= 4000 && request.resource.data.type in ['bug', 'idea', 'feedback']; }
      allow read: if canUse();
      allow create: if canUse() && request.resource.data.by == uid() && request.resource.data.status == 'new' && fbFields()
                    && request.resource.data.keys().hasOnly(['type','page','title','details','steps','expected','status','by','memberId','name','device','version','photos','votes','at','updatedAt'])
                    && votesOf(request.resource.data).keys().hasOnly([uid()]);
      allow update: if isAdmin()
                    || (canUse() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes']) && onlyMyVote())
                    || (canUse() && resource.data.by == uid() && resource.data.status == 'new'
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['type','page','title','details','steps','expected','updatedAt']) && fbFields());
      allow delete: if isAdmin() || (canUse() && resource.data.by == uid() && resource.data.status == 'new');
    }
    match /appSettings/{id} {
      allow read: if canUse();
      allow write: if isAdmin();
    }

    // ---- club challenges: coaches and admins build them; members may only join/leave (their own key in participants)
    match /challenges/{id} {
      function partsOf(d) { return d.get('participants', {}); }
      allow read: if canUse();
      allow create, delete: if isAdmin() || isCoach();
      allow update: if isAdmin() || isCoach()
                    || (isMember() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
                        && partsOf(request.resource.data).diff(partsOf(resource.data)).affectedKeys().hasOnly([myMemberId()]));
    }

    // ---- erg waitlist: one entry per member per session date, id = {sessionId}_{YYYYMMDD}_{memberId}.
    // The server (functions) gives a freed erg to the first in line and deletes the entry.
    match /waitlist/{id} {
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid()
                                      && request.resource.data.memberId == myMemberId()
                                      && id == request.resource.data.sessionId + '_' + request.resource.data.date.replace('-', '') + '_' + myMemberId()
                                      && request.resource.data.group is string
                                      && request.resource.data.t is int        // place in line = time joined (ms)
                                      && math.abs(request.resource.data.t - request.time.toMillis()) < 300000);
      allow update: if false;
      allow delete: if isAdmin() || (isMember() && resource.data.memberId == myMemberId());
    }

    // ---- open erg: members book an erg for themselves outside programmed erg time ----
    match /openErg/{id} {
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid()
                                      && request.resource.data.memberId == myMemberId()
                                      && request.resource.data.erg is int
                                      && request.resource.data.erg >= 1 && request.resource.data.erg <= 18);
      allow update, delete: if isAdmin() || (isMember() && resource.data.by == uid());
    }

    // ---- Concept2 connection: the server function holds the tokens; browsers can't read them ----
    match /c2States/{state} {        // one-time 'state' for the Concept2 sign-in round trip
      allow create: if signedIn() && request.resource.data.uid == uid()
                    && request.resource.data.keys().hasOnly(['uid', 'at']);
    }
    match /c2Links/{u} {             // 'connected as …' status, written only by the server
      allow read: if signedIn() && (u == uid() || isAdmin());
    }
    match /mailLog/{id} { allow read: if isAdmin(); }   // member emails sent by the server (admin page shows status)
    match /c2Tokens/{u} { allow read, write: if false; }
    match /c2Users/{c2id} { allow read, write: if false; }

    // ---- scheduled maintenance: admins schedule; members can join/leave the crew; the crew can mark it done ----
    match /maintJobs/{id} {
      function crewChange() {           // only adds or removes the signed-in member
        let before = resource.data.get('crew', []).toSet();
        let after = request.resource.data.get('crew', []).toSet();
        return after.difference(before).union(before.difference(after)).hasOnly([myMemberId()]);
      }
      allow read: if canUse();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
                    || (isMember() && resource.data.status == 'scheduled' && onlyChanges(['crew', 'updatedAt']) && crewChange())
                    || (isMember() && myMemberId() in resource.data.crew
                        && onlyChanges(['status', 'doneAt', 'doneNotes', 'updatedAt'])
                        && request.resource.data.status == 'done');
    }
    match /events/{id} {                  // boat activity log
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid());
      allow update, delete: if isAdmin();
    }

    // ---- attendance: coaches and admins check athletes in; everyone in the club can see it ----
    match /attendance/{id} {
      allow read: if canUse();
      allow write: if isAdmin() || isCoach();
    }

    // ---- results: members log their own training; anyone in the club can add/remove only their own like ----
    match /results/{id} {
      function likesOf(d) { return d.get('likes', {}); }
      function onlyMyLike() { return likesOf(request.resource.data).diff(likesOf(resource.data)).affectedKeys().hasOnly([uid()]); }
      allow read: if canUse();
      allow create: if isAdmin() || (isMember() && request.resource.data.by == uid()
                                      && request.resource.data.memberId == myMemberId()
                                      && likesOf(request.resource.data).size() == 0);
      allow update: if isAdmin()
                    || (isMember() && resource.data.by == uid()                        // my own result
                        && request.resource.data.by == uid()
                        && request.resource.data.memberId == resource.data.memberId
                        && onlyMyLike())
                    || (isMember() && onlyChanges(['likes']) && onlyMyLike());        // liking someone else's
      allow delete: if isAdmin() || (isMember() && resource.data.by == uid());
    }

    // ---- bookings: the booker/captain or an admin manages a booking; crew can leave; anyone eligible can join an open seat ----
    match /bookings/{id} {
      function inCrew(data) { return myMemberId() in data.crew || data.cox == myMemberId(); }
      function isBooker() { return resource.data.createdBy == uid() || resource.data.captain == myMemberId(); }

      allow read: if canUse();
      allow create: if isAdmin() || (isMember()
                       && request.resource.data.createdBy == uid()
                       && inCrew(request.resource.data));
      allow update: if isAdmin()
                    || (isMember() && isBooker()
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.captain == resource.data.captain)
                    || (isMember() && onlyChanges(['crew', 'cox', 'open', 'updatedAt'])
                        && (inCrew(resource.data)                                         // leaving / swapping out
                            || (resource.data.open == true && inCrew(request.resource.data)))); // joining an open seat
      allow delete: if isAdmin() || (isMember() && isBooker());
    }

    // everything else is closed
    match /{document=**} { allow read, write: if false; }
  }
}
