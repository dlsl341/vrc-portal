{
  "name": "icg-retail-ops-portal",
  "version": "1.40.0",
  "description": "ICG Retail Operations Portal",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "firebase emulators:start --only auth,firestore,storage",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "deploy": "npm run build && firebase deploy",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes,storage",
    "deploy:email": "npm --prefix functions install && firebase deploy --only functions"
  },
  "dependencies": {
    "firebase": "^13.4.0"
  },
  "devDependencies": {
    "firebase-tools": "^15.37.0",
    "vite": "^8.3.8"
  },
  "private": true,
  "type": "module"
}
